generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id  Int  @id @default(autoincrement())
  name String
  email String
  password String
}

model Collection {
  id  Int  @id @default(autoincrement())
  title String
  description String?
  image String?
  products Product[]
}

model Product {
  id  Int  @id @default(autoincrement())
  Collection Collection @relation(fields: [collectionId], references: [id])
  collectionId Int
  name String
  desc String?
  image String?
  price Float
}
